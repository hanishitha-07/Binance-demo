OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini

PINECONE_API_KEY=your-pinecone-key-here
PINECONE_INDEX=f1
PINECONE_NAMESPACE=archive

OPENROUTER_EMBED_MODEL=openai/text-embedding-3-large
EMBEDDING_DIMENSION=1024

RAG_TOP_K=5

# Binance (public market data needs no key; --account needs demo/live keys)
BINANCE_API_KEY=your-binance-key-here
BINANCE_API_SECRET=your-binance-secret-here
BINANCE_ENV=demo
BINANCE_MARKET=futures
BINANCE_QUOTE=USDT

# Dashboard configuration
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=0
DASHBOARD_MIN_VOLUME=1000000
DASHBOARD_TABLE_LIMIT=100
